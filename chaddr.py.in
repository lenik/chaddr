#!@PYTHON@
"""Address edit tool: manually change or reallocate profile-managed IP addresses."""

from __future__ import annotations

import sys
from pathlib import Path

# Source-tree / editable checkout: package lives next to this launcher.
ROOT = Path(__file__).resolve().parent
if (ROOT / "chaddr").is_dir() and str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

# Installed package path (Meson py_install_dir). Needed when the shebang
# interpreter differs from the one that owns dist-packages (e.g. a venv
# earlier on PATH than /usr/bin/python3).
_PY_INSTALL_DIR = "@PY_INSTALL_DIR@"
if _PY_INSTALL_DIR and "@" not in _PY_INSTALL_DIR:
    install_root = Path(_PY_INSTALL_DIR)
    if (install_root / "chaddr").is_dir() and str(install_root) not in sys.path:
        sys.path.append(str(install_root))

import os

if sys.platform.startswith("linux") and "GTK_A11Y" not in os.environ:
    os.environ["GTK_A11Y"] = "none"

from chaddr.cli import main

if __name__ == "__main__":
    raise SystemExit(main())
