#: src/cli.py:43
msgid "Change or reallocate IP addresses defined in profile files."
msgstr "Modifier ou réallouer les adresses IP définies dans les fichiers de profil."

#: src/cli.py:48
msgid "Profile name(s) under ~/.config/chaddr/profile/ (override with CHADDR_PROFILE_DIR)"
msgstr "Nom(s) de profil sous ~/.config/chaddr/profile/ (surcharge via CHADDR_PROFILE_DIR)"

#: src/cli.py:53
msgid "FILE"
msgstr "FICHIER"

#: src/cli.py:54
msgid "JSON config file with API keys/secrets (default: ./chaddr.conf or ~/.config/chaddr/chaddr.conf)"
msgstr "Fichier de config JSON avec clés/secrets API (défaut : ./chaddr.conf ou ~/.config/chaddr/chaddr.conf)"

#: src/cli.py:58
msgid "Proxy URL, e.g. socks5://127.0.0.1:1080 or http://127.0.0.1:8080"
msgstr "URL de proxy, p.ex. socks5://127.0.0.1:1080 ou http://127.0.0.1:8080"

#: src/cli.py:63
msgid "Run diagnosis only (CLI mode); with --apply IP, that IP is the diagnose target"
msgstr "Exécuter uniquement le diagnostic (mode CLI) ; avec --apply IP, cette IP est la cible"

#: src/cli.py:69
msgid "List all candidate addresses for profile(s) (CLI mode)"
msgstr "Lister toutes les adresses candidates pour le(s) profil(s) (mode CLI)"

#: src/cli.py:74
msgid "Reallocate elastic IP and propagate (CLI mode)"
msgstr "Réallouer l'IP élastique et propager (mode CLI)"

#: src/cli.py:78 src/cli.py:83 src/cli.py:88
msgid "IP"
msgstr "IP"

#: src/cli.py:79
msgid "Manually apply IPv4/IPv6 to profile (CLI mode)"
msgstr "Appliquer manuellement IPv4/IPv6 au profil (mode CLI)"

#: src/cli.py:84
msgid "New IPv4 for manual apply"
msgstr "Nouvelle IPv4 pour l'application manuelle"

#: src/cli.py:89
msgid "New IPv6 for manual apply"
msgstr "Nouvelle IPv6 pour l'application manuelle"

#: src/cli.py:93
msgid "Old IP for manual apply when auto-detection fails"
msgstr "Ancienne IP pour l'application manuelle si la détection auto échoue"

#: src/cli.py:100
msgid "Increase logging verbosity"
msgstr "Augmenter la verbosité des journaux"

#: src/cli.py:105
msgid "Force CLI mode even without action flags"
msgstr "Forcer le mode CLI même sans drapeaux d'action"

#: src/cli.py:227
msgid "No CLI action specified; use --diagnose, --renew, or --apply"
msgstr "Aucune action CLI spécifiée ; utilisez --diagnose, --renew ou --apply"
